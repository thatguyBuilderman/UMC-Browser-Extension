{
  "manifest_version": 3,
  "name": "Meeland Client",
  "version": "1.0.0",
  "description": "Userscripts, styles and assets for meeland.io",
  "icons": { "128": "assets/meeland.png" },
  "permissions": ["storage", "clipboardRead"],
  "host_permissions": ["https://meeland.io/*", "https://*.meeland.io/*"],
  "content_scripts": [
    {
      "matches": ["https://meeland.io/*", "https://*.meeland.io/*"],
      "js": ["content/page-shim.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://meeland.io/*", "https://*.meeland.io/*"],
      "js": ["content/bridge.js"],
      "css": ["styles/custom.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://meeland.io/*", "https://*.meeland.io/*"],
      "js": [
        "userscripts/userscript.js",
        "userscripts/Dashboard.js",
        "userscripts/meeland-badges.js",
        "userscripts/VIST.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["https://meeland.io/*", "https://*.meeland.io/*"]
    }
  ]
}